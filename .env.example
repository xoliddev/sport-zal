# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). The placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Public HTTPS address of this server, without a trailing slash (for example a free cloudflared tunnel).
# The Mini App opens at https://<address>/webapp/ and the admin panel at https://<address>/admin/.
# Leave empty to run the bot only (no Mini App, no panel sign-in links).
PUBLIC_URL=

# Telegram user ids (comma separated; find yours with @userinfobot).
# OWNER_IDS see everything, revenue included, and change prices. ADMIN_IDS work the front desk.
OWNER_IDS=
ADMIN_IDS=
# Trainers of shared/data/schedule.json with their Telegram ids, for example: malika:123456789,sherzod:987654321
TRAINERS=

# Key that signs the rotating check-in QR codes. Any long random text; if empty, one is derived from BOT_TOKEN.
QR_SECRET=

# Show the Telegram Login Widget on the panel's sign-in page (needs /setdomain in @BotFather). 0 = only the bot's link.
LOGIN_WIDGET=0

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/sportzal.db
# Fill an empty database with the fictional gym (members, five weeks of visits, classes). 0 = start empty.
# Seeded people have negative ids, so nobody can sign in as them.
SEED_DEMO=1

# Web server for the Mini App, the panel and their APIs.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Per minute: bot buttons per user, Mini App calls per user, panel calls per staff member, sign-in attempts per address.
RATE_PER_MINUTE=30
API_RATE_PER_MINUTE=120
PANEL_RATE_PER_MINUTE=240
LOGIN_RATE_PER_MINUTE=10
# Set to 1 only behind a reverse proxy you control (then X-Forwarded-For is trusted for the sign-in rate limit).
TRUST_PROXY=0
LOG_LEVEL=INFO
